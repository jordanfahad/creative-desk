# ── OpenAI ───────────────────────────────────────────────────────────
# Used by app/api/generate-brief — turns a job + context into a brief.
OPENAI_API_KEY=

# ── fal.ai ───────────────────────────────────────────────────────────
# Used by app/api/render/* for BOTH stills (FLUX) and video (image-to-video).
# Format: <id>:<secret>.
FAL_KEY=
# Optional model overrides:
# FAL_IMAGE_MODEL=fal-ai/flux/schnell
# FAL_VIDEO_MODEL=fal-ai/ltx-video-13b-distilled/image-to-video

# ── Local store ──────────────────────────────────────────────────────
# SQLite file + asset folder live on disk; no cloud DB. Defaults are fine.
CREATIVE_DESK_DB=./data/creative-desk.db
CREATIVE_DESK_STORAGE=./storage
