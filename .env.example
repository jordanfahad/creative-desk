# ── OpenAI ───────────────────────────────────────────────────────────
# Used by app/api/generate-brief — turns a job + context into a brief (gpt-4o).
OPENAI_API_KEY=

# ── fal.ai ───────────────────────────────────────────────────────────
# Used by app/api/render/* for BOTH stills (FLUX + Kontext) and video (Kling).
# Format: <id>:<secret>.
FAL_KEY=

# ── Supabase (live data + storage) ───────────────────────────────────
# The live database (Postgres) and asset/render storage. Source of truth.
SUPABASE_URL=
SUPABASE_SECRET_KEY=                          # service-role / secret key (server-side only)
SUPABASE_BUCKET=creative-desk                 # public bucket (assets, finished renders)
SUPABASE_PRIVATE_BUCKET=creative-desk-private # private bucket (uploads, source PDFs)

# ── Sign-in ──────────────────────────────────────────────────────────
# Login accounts live in public.cd_auth (bcrypt, verified in Postgres via
# cd_verify_login). Session cookies are HMAC-signed with SUPABASE_SECRET_KEY —
# no extra variable needed. Without SUPABASE_SECRET_KEY (bare local dev) the
# gate is open.

# ── Legacy (local scripts only) ──────────────────────────────────────
# Used only by the legacy SQLite scripts (db/schema.sql, scripts/seed.mjs).
# Not used by the live Supabase-backed app.
# CREATIVE_DESK_DB=./data/creative-desk.db
# CREATIVE_DESK_STORAGE=./storage
